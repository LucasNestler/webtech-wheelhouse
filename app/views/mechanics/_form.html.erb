<%= form_with model: mechanic, local: true do |f| %>
  <% if mechanic.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(mechanic.errors.count, "error") %> prohibited this staff member from being saved:</h5>
      <ul class="mb-0">
        <% mechanic.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(mechanic, :name, "form-control") %>
    <%= invalid_feedback(mechanic, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: field_class(mechanic, :role, "form-control") %>
    <%= invalid_feedback(mechanic, :role) %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", mechanic.persisted? ? mechanic : mechanics_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<%= form_with model: bike, local: true do |f| %>
  <% if bike.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(bike.errors.count, "error") %> prohibited this bike from being saved:</h5>
      <ul class="mb-0">
        <% bike.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: field_class(bike, :serial_number, "form-control") %>
    <%= invalid_feedback(bike, :serial_number) %>
  </div>

  <div class="mb-3">
    <%= f.label :make, class: "form-label" %>
    <%= f.text_field :make, class: field_class(bike, :make, "form-control") %>
    <%= invalid_feedback(bike, :make) %>
  </div>

  <div class="mb-3">
    <%= f.label :model, class: "form-label" %>
    <%= f.text_field :model, class: field_class(bike, :model, "form-control") %>
    <%= invalid_feedback(bike, :model) %>
  </div>

  <div class="mb-3">
    <%= f.label :color, class: "form-label" %>
    <%= f.text_field :color, class: field_class(bike, :color, "form-control") %>
    <%= invalid_feedback(bike, :color) %>
  </div>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, @customers, :id, :name,
          { include_blank: "Select a customer" }, class: field_class(bike, :customer_id, "form-select") %>
    <%= invalid_feedback(bike, :customer_id) %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", bike.persisted? ? bike : bikes_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

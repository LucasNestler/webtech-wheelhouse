<% content_for :title, @bike.serial_number %>
<h1><%= @bike.make %> <%= @bike.model %></h1>
<p><strong>Serial Number:</strong> <%= @bike.serial_number %></p>
<p><strong>Color:</strong> <%= @bike.color %></p>
<p><strong>Owner:</strong> <%= link_to @bike.customer.name, @bike.customer %></p>

<h2 class="mt-4">Repairs</h2>
<% if @bike.repair_orders.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Repair</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">Status</th>
          <th scope="col">Promised</th>
        </tr>
      </thead>
      <tbody>
        <%= render @bike.repair_orders %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>This bike has never been in for a repair.</p>
<% end %>

<p class="mt-4"><%= link_to "Back to Bikes", bikes_path %></p>

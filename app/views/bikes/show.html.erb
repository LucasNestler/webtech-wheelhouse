<% content_for :title, @bike.serial_number %>
<h1><%= @bike.make %> <%= @bike.model %></h1>
<p><strong>Serial Number:</strong> <%= @bike.serial_number %></p>
<p><strong>Color:</strong> <%= @bike.color %></p>
<p><strong>Owner:</strong> <%= link_to @bike.customer.name, @bike.customer %></p>

<%= render "shared/record_actions", record: @bike, record_label: @bike.serial_number %>

<div class="d-flex justify-content-between align-items-center mt-4">
  <h2 class="mb-0">Repairs</h2>
  <%= link_to "New Repair", new_repair_order_path(bike_id: @bike.id), class: "btn btn-sm btn-primary" %>
</div>
<% if @repair_orders.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Repair</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">Status</th>
          <th scope="col">Promised</th>
          <th scope="col">Photo</th>
          <th scope="col">Diagnosis</th>
        </tr>
      </thead>
      <tbody>
        <%= render @repair_orders %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>This bike has never been in for a repair.</p>
<% end %>

<p class="mt-4"><%= link_to "Back to Bikes", bikes_path %></p>

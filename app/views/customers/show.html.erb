<% content_for :title, @customer.name %>
<h1><%= @customer.name %></h1>
<p><strong>Phone:</strong> <%= @customer.phone %></p>

<%= render "shared/record_actions", record: @customer, record_label: @customer.name %>

<div class="d-flex justify-content-between align-items-center mt-4">
  <h2 class="mb-0">Bikes</h2>
  <%= link_to "New Bike", new_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-primary" %>
</div>
<% if @customer.bikes.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Serial Number</th>
          <th scope="col">Make</th>
          <th scope="col">Model</th>
          <th scope="col">Color</th>
          <th scope="col">Owner</th>
        </tr>
      </thead>
      <tbody>
        <%= render @customer.bikes %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No bikes on file for this customer.</p>
<% end %>

<p class="mt-4"><%= link_to "Back to Customers", customers_path %></p>

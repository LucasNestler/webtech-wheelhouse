<% content_for :title, "Sign in" %>
<h1>Sign in</h1>

<%= form_with url: session_path, class: "mt-4", html: { novalidate: true } do |form| %>
  <div class="mb-3">
    <%= form.label :email_address, "Email address", class: "form-label" %>
    <%= form.email_field :email_address, class: "form-control", required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>

  <div class="mb-3">
    <%= form.label :password, class: "form-label" %>
    <%= form.password_field :password, class: "form-control", required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>

  <%= form.submit "Sign in", class: "btn btn-primary" %>
<% end %>

<p class="mt-4 mb-1"><%= link_to "Forgot password?", new_password_path %></p>
<p>New here? <%= link_to "Sign up", new_registration_path %></p>

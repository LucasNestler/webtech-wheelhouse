<% content_for :title, "Forgot your password?" %>
<h1>Forgot your password?</h1>

<%= form_with url: passwords_path, class: "mt-4", html: { novalidate: true } do |form| %>
  <div class="mb-3">
    <%= form.label :email_address, "Email address", class: "form-label" %>
    <%= form.email_field :email_address, class: "form-control", required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>

  <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
<% end %>

<p class="mt-4"><%= link_to "Back to sign in", new_session_path %></p>

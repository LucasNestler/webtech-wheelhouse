<% content_for :title, "Services & Prices" %>
<h1>Services & Pricing</h1>
<p class="lead">We charge by the job, not by the hour. Here is our wall list of standard repairs:</p>

<% if @services.any? %>
  <div class="table-responsive mt-4">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Service / Job</th>
          <th scope="col">Standard Price</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @services.each do |service| %>
          <tr>
            <td><%= link_to service.name, service %></td>
            <td><strong><%= number_to_currency service.default_price %></strong></td>
            <td>
              <% if service.active %>
                <span class="badge bg-success">Active</span>
              <% else %>
                <span class="badge bg-secondary">Inactive</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No services yet.</p>
<% end %>

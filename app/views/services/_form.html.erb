<%= form_with model: service, local: true do |f| %>
  <% if service.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(service.errors.count, "error") %> prohibited this service from being saved:</h5>
      <ul class="mb-0">
        <% service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(service, :name, "form-control") %>
    <%= invalid_feedback(service, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :default_price, "Standard Price", class: "form-label" %>
    <%= f.number_field :default_price, step: 0.01, min: 0.01, class: field_class(service, :default_price, "form-control") %>
    <%= invalid_feedback(service, :default_price) %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :active, class: field_class(service, :active, "form-check-input") %>
    <%= f.label :active, "Listed as active", class: "form-check-label" %>
    <%= invalid_feedback(service, :active) %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", service.persisted? ? service : services_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

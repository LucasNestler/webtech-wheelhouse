<h1>Services & Pricing</h1>
<p class="lead">We charge by the job, not by the hour. Here is our wall list of standard repairs:</p>

<div class="table-responsive mt-4">
  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th scope="col">Service / Job</th>
        <th scope="col">Standard Price</th>
      </tr>
    </thead>
    <tbody>
      <% @jobs.each do |job| %>
        <tr>
          <td><%= job[:name] %></td>
          <td><strong><%= job[:price] %></strong></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
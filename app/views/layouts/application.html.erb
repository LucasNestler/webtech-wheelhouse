<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title).presence || "Wheelhouse Bicycle Repair" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
      <div class="container">
        <%= link_to "Wheelhouse", authenticated? ? root_path : services_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if authenticated? %>
              <li class="nav-item">
                <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
              </li>
              <% if policy(Customer).index? %>
                <li class="nav-item">
                  <%= link_to "Customers", customers_path, class: "nav-link #{'active' if current_page?(customers_path)}" %>
                </li>
              <% end %>
              <% if policy(Bike).index? %>
                <li class="nav-item">
                  <%= link_to "Bikes", bikes_path, class: "nav-link #{'active' if current_page?(bikes_path)}" %>
                </li>
              <% end %>
              <% if policy(RepairOrder).index? %>
                <li class="nav-item">
                  <%= link_to "Repairs", repair_orders_path, class: "nav-link #{'active' if current_page?(repair_orders_path)}" %>
                </li>
              <% end %>
              <% if policy(Service).index? %>
                <li class="nav-item">
                  <%= link_to "Services & Prices", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
                </li>
              <% end %>
              <% if policy(Mechanic).index? %>
                <li class="nav-item">
                  <%= link_to "Staff", mechanics_path, class: "nav-link #{'active' if current_page?(mechanics_path)}" %>
                </li>
              <% end %>
              <li class="nav-item">
                <%= link_to "Visiting the Workshop", visit_path, class: "nav-link #{'active' if current_page?(visit_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "About Us", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
              </li>
              <li class="nav-item d-flex align-items-center ms-lg-3">
                <span class="navbar-text text-white me-2"><%= Current.user.display_name %> (<%= Current.user.role.humanize %>)</span>
                <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-sm btn-outline-light" %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Price List", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign in", new_session_path, class: "nav-link #{'active' if current_page?(new_session_path)}" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
    
    <main class="container">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
  </body>
</html>

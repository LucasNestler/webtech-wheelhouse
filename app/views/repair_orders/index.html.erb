<% content_for :title, "Repairs" %>
<div class="d-flex justify-content-between align-items-center">
  <h1>Repairs</h1>
  <% if policy(RepairOrder).new? %>
    <%= link_to "New Repair", new_repair_order_path, class: "btn btn-primary" %>
  <% end %>
</div>

<div class="d-flex flex-wrap gap-2 mt-3">
  <%= repair_filter_link "All", params[:state].blank? && params[:overdue].blank? %>
  <% RepairOrder.statuses.each do |state, label| %>
    <%= repair_filter_link label, params[:state] == state, state: state %>
  <% end %>
  <%= repair_filter_link "Overdue", params[:overdue].present?, overdue: 1 %>
</div>

<% if @repair_orders.any? %>
  <div class="table-responsive mt-4">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th scope="col">Repair</th>
          <th scope="col">Bike</th>
          <th scope="col">Customer</th>
          <th scope="col">Status</th>
          <th scope="col">Promised</th>
          <th scope="col">Photo</th>
          <th scope="col">Diagnosis</th>
          <th scope="col">Taken in by</th>
        </tr>
      </thead>
      <tbody>
        <%= render @repair_orders %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="mt-4">No repairs to show.</p>
<% end %>

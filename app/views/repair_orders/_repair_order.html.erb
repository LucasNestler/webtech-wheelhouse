<tr class="<%= "table-danger" if repair_order.overdue? %>">
  <td><%= link_to "Repair ##{repair_order.id}", repair_order %></td>
  <td><%= link_to repair_order.bike.serial_number, repair_order.bike %></td>
  <td><%= link_to repair_order.bike.customer.name, repair_order.bike.customer %></td>
  <td><span class="badge bg-secondary"><%= repair_order.status_label %></span></td>
  <td><%= l repair_order.promised_on, format: :long %></td>
  <td>
    <% if (photo = repair_order.intake_photos.first) %>
      <%= link_to repair_order do %>
        <%= image_tag photo.variant(:thumb), class: "rounded", alt: intake_photo_alt(repair_order) %>
      <% end %>
    <% else %>
      <span class="text-muted small">No photo</span>
    <% end %>
  </td>
  <td class="text-truncate" style="max-width: 20rem;">
    <% if repair_order.diagnosis.present? %>
      <%= repair_order.diagnosis_preview %>
    <% else %>
      <span class="text-muted">&mdash;</span>
    <% end %>
  </td>
</tr>
